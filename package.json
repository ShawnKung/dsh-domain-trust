{
  "name": "dsh-domain-trust",
  "version": "0.1.3",
  "description": "DSH Web trusted-domain bootstrap for reverse-proxy and tunnel deployments.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node --check index.js && node --check src/client.js && node --check scripts/build-client.mjs && node --check client.js",
    "test": "node --test",
    "commitlint": "commitlint",
    "ci": "npm run build && npm run check && npm test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run ci"
  },
  "dsh": {
    "id": "dsh-domain-trust",
    "name": "DSH Domain Trust",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShawnKung/dsh-domain-trust.git"
  },
  "bugs": {
    "url": "https://github.com/ShawnKung/dsh-domain-trust/issues"
  },
  "homepage": "https://github.com/ShawnKung/dsh-domain-trust#readme",
  "author": "ShawnKung <gyx215@outlook.com>",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reverse-proxy",
    "tunnel",
    "remote-access"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "esbuild": "^0.28.2"
  }
}
