{
  "name": "dsh-domain-trust",
  "version": "0.1.0",
  "description": "DSH Web trusted-domain bootstrap for reverse-proxy and tunnel deployments.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js",
    "test": "node --test",
    "ci": "npm run check && npm test",
    "prepublishOnly": "npm run ci"
  },
  "dsh": {
    "id": "dsh-domain-trust",
    "name": "DSH Domain Trust",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShawnKung/dsh-domain-trust.git"
  },
  "bugs": {
    "url": "https://github.com/ShawnKung/dsh-domain-trust/issues"
  },
  "homepage": "https://github.com/ShawnKung/dsh-domain-trust#readme",
  "author": "ShawnKung <gyx215@outlook.com>",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reverse-proxy",
    "tunnel",
    "remote-access"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
